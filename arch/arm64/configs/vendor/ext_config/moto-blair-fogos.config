#
# fogos (moto g34 5G / SM6375 blair) - Motorola-specific kernel config fragment.
#
# Ported from the 5.4 fragment arch/arm64/configs/vendor/ext_config/moto-holi-fogos.config.
#
# IMPORTANT: on the 5.4 QGKI kernel most of these drivers were in-tree; on the
# 6.1 blair GKI base the majority are Dynamically Loadable Kernel Modules built
# from kernel/motorola/sm6375-modules. For those, the symbol must be selected by
# the *module* Kconfig (or the module defconfig), NOT here - listing a =m symbol
# that no longer exists in the kernel tree is harmless but does nothing. Keep
# here only symbols that are genuinely compiled into the GKI image.
#
# VERIFY each line against sm6375-6.1 Kconfig + the sm6375-modules tree.

# Device tree
CONFIG_FOGOS_DTB=y

# ---- In-kernel (not DLKM) options to confirm on blair 6.1 ----
# Camera
CONFIG_AF_NOISE_ELIMINATION=y
CONFIG_CAM_SENSOR_PROBE_RETRY=y
CONFIG_CAMERA_FLASH_IIC_COMPATIBLE=y
CONFIG_MOT_DONGWOON_OIS_AF_DRIFT=y
CONFIG_MOT_SECURE_CAMERA=y
CONFIG_MOT_SENSOR_PRE_POWERUP=y
# Fingerprint
CONFIG_INPUT_MISC_FPC1020_SAVE_TO_CLASS_DEVICE=y
CONFIG_GOODIX_DRM_PANEL_NOTIFICATIONS=y
# NFC
CONFIG_SEC_NFC_PRODUCT_N5=y
CONFIG_SEC_NFC_IF_I2C=y
# Pinctrl
CONFIG_QUP0_SE2_AP=y
# Touch (double-tap control is a kernel-side option)
CONFIG_BOARD_USES_DOUBLE_TAP_CTRL=y
CONFIG_TOUCHSCREEN_CHIPONE_V2_MMI_ESD=y
CONFIG_TOUCHSCREEN_CHIPONE_V2_MMI_ENABLE_DOUBLE_TAP=y
CONFIG_TOUCHSCREEN_CHIPONE_V2_MMI_GTP_LAST_TIME=y
CONFIG_TOUCHSCREEN_CHIPONE_V2_MMI_STOWED_MODE_EN=y
CONFIG_TOUCHSCREEN_CHIPONE_V2_MMI_PM_BRL_SPI=y
CONFIG_TOUCHSCREEN_ILITEK_V3_MMI_ENABLE_DOUBLE_TAP=y
CONFIG_TOUCHSCREEN_ILITEK_V3_MMI_USES_DOUBLE_TAP_CTRL=y
CONFIG_TOUCHSCREEN_ILITEK_V3_MMI_SET_TOUCH_STATE=y
CONFIG_TOUCHSCREEN_ILITEK_V3_MMI_RESUME_BY_DDI=y
CONFIG_TOUCHSCREEN_ILITEK_V3_MMI_LAST_TIME=y
CONFIG_TOUCHSCREEN_ILITEK_V3_MMI_STOWED_MODE_EN=y
# Display
# CONFIG_REGULATOR_QPNP_LCDB is not set
# UFS
# CONFIG_UFSHPB is not set
# CONFIG_UFSTW is not set
# CONFIG_SCSI_SKHPB is not set
# CONFIG_MICRON_HPB is not set

# ---- Drivers that are now DLKMs on blair (build via sm6375-modules) ----
# CONFIG_SND_SOC_FS1815        (audio,  fs1815_dlkm.ko)
# CONFIG_CAMERA_CCI_INTF       (camera, cci_intf.ko)
# CONFIG_MMI_SMBCHARGER_IIO    (mmi-smbcharger-iio.ko)
# CONFIG_QPNP_ADAPTIVE_CHARGE  (qpnp_adaptive_charge.ko)
# CONFIG_INPUT_MISC_FPC1020    (fpc1020_mmi.ko)
# CONFIG_INPUT_GOODIX_FOD_MMI  (goodix_fod_mmi.ko)
# CONFIG_RADIO_ELNA            (fm_ctrl.ko)
# CONFIG_MMI_ANNOTATE          (mmi_annotate.ko)
# CONFIG_MMI_INFO              (mmi_info.ko)
# CONFIG_MMI_RELAY             (mmi_relay.ko)
# CONFIG_MMI_SYS_TEMP          (mmi_sys_temp.ko)
# CONFIG_MOTO_UTAGS            (utags.ko)
# CONFIG_SENSORS_CLASS         (sensors_class.ko)
# CONFIG_SEC_NFC               (sec_nfc.ko)
# CONFIG_SARSENSOR_SX937X      (sx937x_sar.ko)
# CONFIG_TOUCHSCREEN_CHIPONE_V2_MMI (chipone_tddi_v2_mmi.ko)
# CONFIG_TOUCHSCREEN_ILITEK_V3_MMI  (ilitek_v3_mmi.ko)
# CONFIG_LDO_VIBRATOR_MMI      (ldo_vibrator_mmi.ko)
